# Copy to .env and fill in. Never commit .env.
# Blank values fall back to the defaults in backend/app/config.py.

# Meta Model API (confirm IDs and endpoints in the Meta docs, log them in docs/decisions.md)
META_API_KEY=
META_BASE_URL=
MODEL_FAST=
MODEL_SMART=
MODEL_STT=
STT_REALTIME_URL=
# reasoning_effort for live call turns: minimal (default, fastest), low, medium, high, xhigh, max.
# "none" is not supported by Muse models (HTTP 400).
CALL_REASONING=
# Lana's intake turns (her chat with the patient). Blank INTAKE_MODEL means MODEL_FAST;
# blank INTAKE_REASONING means low. Tested choice: muse-spark-1.3 at low (docs/decisions.md).
INTAKE_MODEL=
INTAKE_REASONING=

# Voice (ElevenLabs). VOICE_AGENT is Lana's voice: a female ElevenLabs voice ID.
ELEVENLABS_API_KEY=
# Text to speech model per speaker. Blank means ELEVENLABS_MODEL if that is set,
# else eleven_v4_turbo for Lana and eleven_flash_v2_5 for the clinics.
ELEVENLABS_MODEL_AGENT=
ELEVENLABS_MODEL_CLINIC=
ELEVENLABS_MODEL=
# Audio tag put before Lana's lines when her model supports tags (v3/v4). Never shown on screen.
# Blank means [warmly].
ELEVENLABS_TAG_AGENT=
# Voice settings, 0 to 1. Blank means stability 0.4, similarity 0.8, style 0.3, speaker boost true.
# Lower stability sounds more expressive but varies more between takes.
ELEVENLABS_STABILITY=
ELEVENLABS_SIMILARITY=
ELEVENLABS_STYLE=
ELEVENLABS_SPEAKER_BOOST=
AGENT_NAME=
VOICE_AGENT=
VOICE_CLINIC_1=
VOICE_CLINIC_2=
VOICE_CLINIC_3=
# The demo patient who asks Lana for help at the start of Watch mode. Pick a voice that
# differs from Lana and the clinics. Blank falls back to VOICE_CLINIC_1.
VOICE_PATIENT=

# Turn taking: milliseconds to wait after the patient stops talking before Lana answers.
# Speech within this window joins the same turn, so a pause mid-sentence isn't interrupted.
# Blank means 700.
END_GRACE_MS=
# Be the clinic: seconds the judge may stay silent before Lana says "Sorry, I didn't catch that."
# (a second silence ends that call politely), and seconds she waits for an answer to her hold
# request before calling the next clinic anyway. Blank means 12 and 8.
JUDGE_SILENCE_S=
JUDGE_HOLD_S=

# App
DATABASE_URL=
TIMEZONE=
# The web app's origins, comma-separated. Blank means http://localhost:5173.
# In production: https://lana-health.pages.dev,http://localhost:5173
WEB_ORIGIN=
# Optional: more allowed origins by regex, e.g. Cloudflare Pages preview URLs:
# https://[a-z0-9-]+\.lana-health\.pages\.dev
WEB_ORIGIN_REGEX=
PUBLIC_BASE_URL=

# Demo usage limits. Blank means: 2 runs per case, 20 new cases per IP per hour
# (the IP comes from X-Forwarded-For behind Railway's proxy),
# 60 LLM calls per case, 4,000 TTS characters per case and 30,000 per day across all cases,
# and 300 seconds of speech to text per case.
# TTS characters count only what is sent to ElevenLabs (cached lines are free).
# STT seconds count only real mic audio; nothing is sent to Meta while Lana talks.
MAX_RUNS_PER_CASE=
MAX_CASES_PER_IP_HOUR=
MAX_LLM_CALLS_PER_CASE=
MAX_TTS_CHARS_PER_CASE=
MAX_TTS_CHARS_PER_DAY=
MAX_STT_SECONDS_PER_CASE=

# What Lana asks on each call, comma-separated. Blank means total_price,records_fee,monthly_payment,next_slots.
# All fields: total_price, records_fee, includes, monthly_payment, down_payment, next_slots, evening_hours.
# The extractor still records any other field the clinic mentions.
DEMO_CHECKLIST=

# Safety switches: keep real calls off until you mean it.
# ALLOWED_CALL_NUMBERS is comma-separated E.164, e.g. +12145550100
ENABLE_REAL_CALLS=
ALLOWED_CALL_NUMBERS=

# Stretch goal only (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
