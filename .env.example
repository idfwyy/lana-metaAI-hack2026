# Copy to .env and fill in. Never commit .env.
# Blank values fall back to the defaults in backend/app/config.py.

# Meta Model API (confirm IDs and endpoints in the Meta docs, log them in docs/decisions.md)
META_API_KEY=
META_BASE_URL=
MODEL_FAST=
MODEL_SMART=
MODEL_STT=
STT_REALTIME_URL=
# reasoning_effort for live call turns: minimal (default, fastest), low, medium, high, xhigh, max.
# "none" is not supported by Muse models (HTTP 400).
CALL_REASONING=

# Voice (ElevenLabs). VOICE_AGENT is Lana's voice: a female ElevenLabs voice ID.
ELEVENLABS_API_KEY=
# Text to speech model per speaker. Blank means ELEVENLABS_MODEL if that is set,
# else eleven_v4_turbo for Lana and eleven_flash_v2_5 for the clinics.
ELEVENLABS_MODEL_AGENT=
ELEVENLABS_MODEL_CLINIC=
ELEVENLABS_MODEL=
# Audio tag put before Lana's lines when her model supports tags (v3/v4). Never shown on screen.
# Blank means [warmly].
ELEVENLABS_TAG_AGENT=
# Voice settings, 0 to 1. Blank means stability 0.4, similarity 0.8, style 0.3, speaker boost true.
# Lower stability sounds more expressive but varies more between takes.
ELEVENLABS_STABILITY=
ELEVENLABS_SIMILARITY=
ELEVENLABS_STYLE=
ELEVENLABS_SPEAKER_BOOST=
AGENT_NAME=
VOICE_AGENT=
VOICE_CLINIC_1=
VOICE_CLINIC_2=
VOICE_CLINIC_3=

# App
DATABASE_URL=
TIMEZONE=
WEB_ORIGIN=
PUBLIC_BASE_URL=

# Safety switches: keep real calls off until you mean it.
# ALLOWED_CALL_NUMBERS is comma-separated E.164, e.g. +12145550100
ENABLE_REAL_CALLS=
ALLOWED_CALL_NUMBERS=

# Stretch goal only (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
