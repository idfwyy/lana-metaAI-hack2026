# Where Lana's backend runs. In production both must be the Railway domain over https / wss,
# e.g. VITE_API_URL=https://your-app.up.railway.app
# VITE_WS_URL is optional: blank derives it from VITE_API_URL (https -> wss, http -> ws).
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
# Optional: where "Need a code? Ask Rahul" goes on the access code step (https:// or mailto: link,
# opens in a new tab). Blank hides the link.
VITE_CONTACT_URL=
